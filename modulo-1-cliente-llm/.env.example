# Copiá este archivo como .env y completá tus keys. El .env nunca se sube al repo.

# Proveedor a usar: openai | anthropic
LLM_PROVIDER=openai

# Sólo es obligatoria la key del proveedor elegido.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcionales: modelo de cada proveedor (estos son los valores por defecto).
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-opus-5-5

# Opcional: máximo de llamadas simultáneas por manager.
LLM_MAX_CONCURRENCY=5
