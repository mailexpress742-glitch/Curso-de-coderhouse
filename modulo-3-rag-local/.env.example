# Copiá este archivo como .env y completá tus keys. El .env nunca se sube al repo.

# Proveedor del modelo de lenguaje: openai | anthropic
LLM_PROVIDER=openai

# Sólo es obligatoria la key del proveedor elegido.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcionales: modelo de cada proveedor (estos son los valores por defecto).
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-opus-5-5

# Embeddings: local (corre en tu máquina, sin key) | openai (necesita OPENAI_API_KEY)
EMBEDDINGS_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Opcionales: fragmentos de 500 tokens con 50 de overlap, 5 fragmentos por consulta.
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
