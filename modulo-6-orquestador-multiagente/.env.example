# Copiá este archivo como .env y completá tu key. El .env nunca se sube al repo.

# Proveedor del modelo de lenguaje: openai | anthropic
LLM_PROVIDER=openai

# Sólo es obligatoria la key del proveedor elegido.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcionales: modelo de cada proveedor (estos son los valores por defecto).
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-opus-5-5

# Opcionales: condiciones de parada del supervisor y techo de pasos del grafo.
SUPERVISOR_MAX_STEPS=8
SUPERVISOR_MAX_ATTEMPTS=2
GRAPH_RECURSION_LIMIT=40
