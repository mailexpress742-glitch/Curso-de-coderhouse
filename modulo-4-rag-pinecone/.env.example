# Copiá este archivo como .env y completá tus keys. El .env nunca se sube al repo.

# Obligatoria: key de Pinecone (https://app.pinecone.io -> API Keys)
PINECONE_API_KEY=

# Nombre del índice y namespace donde se guardan los documentos.
INDEX_NAME=rag-pydantic-docs
PINECONE_NAMESPACE=pydantic-docs

# Opcionales: dónde se crea el índice Serverless.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Embeddings: local (corre en tu máquina, sin key, 768 dimensiones) | openai (1536 dimensiones)
EMBEDDINGS_PROVIDER=local
LOCAL_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-es
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Solo si EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=

# Opcionales: fragmentos de 600 tokens con 60 de overlap, 5 resultados,
# y peso de BM25 en la combinación (el resto es de la búsqueda vectorial).
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=60
RAG_TOP_K=5
BM25_WEIGHT=0.4
