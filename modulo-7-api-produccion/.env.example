# Copiá este archivo como .env y completá tu key. El .env nunca se sube al repo.

# Proveedor del modelo de lenguaje: openai | anthropic
LLM_PROVIDER=openai

# Sólo es obligatoria la key del proveedor elegido.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcionales: modelo de cada proveedor (estos son los valores por defecto).
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-opus-5-5

# Redis: estado de los jobs y checkpoints del grafo. Necesita Redis Stack (RediSearch + RedisJSON).
REDIS_URL=redis://localhost:6379/0

# Observabilidad: dónde está Phoenix. Si lo dejás vacío no se envían trazas.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=orquestador-multiagente

# Opcionales: tareas simultáneas, tiempo máximo por tarea (s) y paradas del supervisor.
WORKER_CONCURRENCY=5
JOB_TIMEOUT_S=300
SUPERVISOR_MAX_STEPS=8
SUPERVISOR_MAX_ATTEMPTS=2
GRAPH_RECURSION_LIMIT=40
