# Copiá este archivo como .env y completá tu key. El .env nunca se sube al repo.

# Proveedor del modelo de lenguaje: openai | anthropic
LLM_PROVIDER=openai

# Sólo es obligatoria la key del proveedor elegido.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcionales: modelo de cada proveedor (estos son los valores por defecto).
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_MODEL=claude-opus-5-5

# Opcionales: archivo de la memoria, techo de pasos por consulta y mensajes que ve el modelo.
CHECKPOINT_DB=checkpoints.sqlite
AGENT_RECURSION_LIMIT=12
AGENT_MAX_CONTEXT_MESSAGES=30
